{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "baseUrl": ".",
      "paths": {
        "@/*": ["./*"]
      }
    },
    "transpileOnly": true,
    "require": ["tsconfig-paths/register"]
  }
}
